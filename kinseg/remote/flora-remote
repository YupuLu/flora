#!/usr/bin/env bash
# flora-remote: control the remote development server for kinseg experiments.
#
# Configuration: kinseg/remote/remote.env (not in git; copy remote.env.example)
#   FLORA_REMOTE               user@host
#   FLORA_REMOTE_PORT          SSH port (default 22)
#   FLORA_REMOTE_REPO          Flora checkout on the remote, on this branch
#   FLORA_REMOTE_DATA          remote folder for data, autolabel code, outputs and logs
#   FLORA_REMOTE_PYTHON        Python of the remote environment
#   FLORA_REMOTE_PROXY         HTTP proxy the remote needs for GitHub (optional)
#   FLORA_REMOTE_LOCAL_MODELS  module with configure_local_models() (optional; see kinseg/local_models.py)
#
# Commands:
#   sync                                push this branch, then fast-forward the remote checkout to it
#   verify                              check that nobody changed the remote checkout
#   push [--follow] [--exclude PAT]... [--parallel N] [--update] LOCAL REL
#                                       copy a local file or folder into $FLORA_REMOTE_DATA/REL;
#                                       --parallel N uses N streams (the link limits each one),
#                                       --update skips files already there with the same size
#   pull REL LOCAL_DIR                  copy $FLORA_REMOTE_DATA/REL into LOCAL_DIR
#   run [--gpus 0,1 | auto:N[:GiB]] [--bg NAME] -- CMD...
#                                       run CMD in the remote checkout and environment; auto:N picks the N
#                                       GPUs with the most free memory (each at least GiB); --bg detaches
#                                       it with its log in $FLORA_REMOTE_DATA/logs/NAME.log
#   log NAME [LINES]                    end of a background run's log
#   status                              GPU memory and ticli workers
#   launch TICLI_FLAGS... -- CMD...     start a ticli worker pod running CMD in the same environment
#   shell                               interactive SSH session
#
# The remote account is shared, so this script never deletes anything there:
# copies add or update files (tar over ssh, no deletion) and sync only
# fast-forwards. No credentials are kept on the remote; it pulls the public fork.
# Root on a shared account cannot be locked out, so sync, run and launch first
# check the remote checkout and refuse to use it when someone changed it.
set -euo pipefail

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
[[ -f "$here/remote.env" ]] && source "$here/remote.env"
: "${FLORA_REMOTE:?set FLORA_REMOTE in $here/remote.env (see remote.env.example)}"
: "${FLORA_REMOTE_REPO:?set FLORA_REMOTE_REPO in $here/remote.env}"
: "${FLORA_REMOTE_DATA:?set FLORA_REMOTE_DATA in $here/remote.env}"
: "${FLORA_REMOTE_PYTHON:?set FLORA_REMOTE_PYTHON in $here/remote.env}"
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=20 -p "${FLORA_REMOTE_PORT:-22}")

q() { printf '%q' "$1"; }
join_q() { local out="" a; for a in "$@"; do out+="$(q "$a") "; done; printf '%s' "${out% }"; }
remote() { "${SSH[@]}" "$FLORA_REMOTE" "$1"; }
die() { echo "flora-remote: $*" >&2; exit 2; }

env_prefix() {
  local p=""
  if [[ -n "${FLORA_REMOTE_PROXY:-}" ]]; then
    p+="export https_proxy=$(q "$FLORA_REMOTE_PROXY") http_proxy=$(q "$FLORA_REMOTE_PROXY"); "
  fi
  if [[ -n "${FLORA_REMOTE_LOCAL_MODELS:-}" ]]; then
    p+="export FLORA_LOCAL_MODELS=$(q "$FLORA_REMOTE_LOCAL_MODELS"); "
  fi
  p+="export PATH=$(q "$(dirname -- "$FLORA_REMOTE_PYTHON")"):\$PATH PYTHONDONTWRITEBYTECODE=1; "
  p+="cd $(q "$FLORA_REMOTE_REPO")"
  printf '%s' "$p"
}

# Remote checks that refuse code someone else changed on the shared server: no edited tracked
# files, no untracked files under kinseg/, and no commits that are not on GitHub.
remote_guard() {
  printf '%s' "changed=\$(git status --porcelain --untracked-files=no; git status --porcelain --untracked-files=all -- kinseg); \
if [ -n \"\$changed\" ]; then echo 'flora-remote: the remote checkout has local changes:' >&2; echo \"\$changed\" >&2; exit 3; fi; \
up=\$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null) || { echo 'flora-remote: remote branch has no upstream' >&2; exit 3; }; \
extra=\$(git rev-list \"\$up\"..HEAD); \
if [ -n \"\$extra\" ]; then echo 'flora-remote: the remote checkout has commits not on GitHub:' >&2; git log --oneline \"\$up\"..HEAD >&2; exit 3; fi"
}

cmd_verify() {
  remote "$(env_prefix) && $(remote_guard) && echo \"remote checkout clean at \$(git log --oneline -1)\""
}

cmd_sync() {
  local branch
  branch="$(git -C "$here" rev-parse --abbrev-ref HEAD)"
  if [[ -n "$(git -C "$here" status --porcelain --untracked-files=no)" ]]; then
    die "tracked files have uncommitted changes; commit them first (the remote only receives commits)"
  fi
  git -C "$here" push -q origin "$branch"
  local b; b="$(q "$branch")"
  remote "$(env_prefix) && $(remote_guard) && git fetch -q origin && { git checkout -q $b 2>/dev/null || git checkout -q -b $b --track origin/$b; } && git merge -q --ff-only origin/$b && git log --oneline -1"
}

cmd_push() {
  local opts=() follow="" jobs=1 update=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --follow) follow="-h"; shift ;;
      --exclude) opts+=("--exclude=$2"); shift 2 ;;
      --exclude=*) opts+=("$1"); shift ;;
      --parallel) jobs="$2"; shift 2 ;;
      --update) update=1; shift ;;
      *) break ;;
    esac
  done
  [[ $# -eq 2 ]] || die "usage: push [--follow] [--exclude PAT]... [--parallel N] [--update] LOCAL REL"
  local src="$1" dest="$FLORA_REMOTE_DATA/$2"
  [[ -e "$src" ]] || die "no such local path: $src"
  local parent name
  parent="$(dirname -- "$src")"; name="$(basename -- "$src")"
  remote "mkdir -p $(q "$dest")"
  if [[ "$jobs" -le 1 && -z "$update" ]]; then
    tar -C "$parent" $follow --exclude=__pycache__ "${opts[@]}" -czf - "$name" \
      | "${SSH[@]}" "$FLORA_REMOTE" "tar -C $(q "$dest") --no-same-owner -xzf -"
    echo "copied $src -> $FLORA_REMOTE:$dest/$name"
    return
  fi
  # File by file: the link limits each connection, so N streams are faster; --update skips files
  # already on the remote with the same size.
  [[ ${#opts[@]} -eq 0 ]] || die "--exclude is not supported with --parallel/--update"
  local tmp; tmp="$(mktemp -d)"
  (cd "$parent" && find -L "$name" -type f ! -path '*/__pycache__/*' -printf '%s\t%p\n') | sort > "$tmp/local"
  if [[ -n "$update" ]]; then
    "${SSH[@]}" "$FLORA_REMOTE" "cd $(q "$dest") && find $(q "$name") -type f -printf '%s\t%p\n' 2>/dev/null" \
      | sort > "$tmp/remote" || true
    comm -23 "$tmp/local" "$tmp/remote" > "$tmp/todo"
  else
    cp "$tmp/local" "$tmp/todo"
  fi
  local n; n="$(wc -l < "$tmp/todo")"
  echo "$n of $(wc -l < "$tmp/local") files to copy over $jobs streams"
  cut -f2- "$tmp/todo" | awk -v dir="$tmp" -v n="$jobs" '{ print > (dir "/part" (NR % n)) }'
  local part pids=() failed=0
  for part in "$tmp"/part*; do
    [[ -e "$part" ]] || continue
    tar -C "$parent" $follow -czf - -T "$part" \
      | "${SSH[@]}" "$FLORA_REMOTE" "tar -C $(q "$dest") --no-same-owner -xzf -" &
    pids+=("$!")
  done
  for part in "${pids[@]}"; do wait "$part" || failed=1; done
  [[ "$failed" -eq 0 ]] || die "some streams failed; rerun with --update to copy what is missing"
  echo "copied $n files of $src -> $FLORA_REMOTE:$dest/$name"
}

cmd_pull() {
  [[ $# -eq 2 ]] || die "usage: pull REL LOCAL_DIR"
  local src="$FLORA_REMOTE_DATA/$1"
  mkdir -p "$2"
  "${SSH[@]}" "$FLORA_REMOTE" "tar -C $(q "$(dirname -- "$src")") -czf - $(q "$(basename -- "$src")")" | tar -C "$2" -xzf -
  echo "copied $FLORA_REMOTE:$src -> $2/$(basename -- "$src")"
}

# The N GPUs with the most free memory on the remote, each with at least MIN GiB free; comma-separated.
pick_gpus() {
  local n="$1" min_gib="$2" picked
  picked="$(remote "nvidia-smi --query-gpu=index,memory.free --format=csv,noheader,nounits" \
    | awk -F', *' -v min="$((min_gib * 1024))" '$2 >= min { print $2, $1 }' | sort -rn | head -n "$n" \
    | awk '{ print $2 }' | paste -sd, -)"
  [[ -n "$picked" && "$(tr ',' '\n' <<< "$picked" | wc -l)" -eq "$n" ]] \
    || die "fewer than $n GPUs with ${min_gib} GiB free; see 'flora-remote status'"
  printf '%s' "$picked"
}

cmd_run() {
  local gpus="" bg=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --gpus) gpus="$2"; shift 2 ;;
      --bg) bg="$2"; shift 2 ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  [[ $# -gt 0 ]] || die "run: give the command after --"
  if [[ "$gpus" =~ ^auto:([0-9]+)(:([0-9]+))?$ ]]; then
    gpus="$(pick_gpus "${BASH_REMATCH[1]}" "${BASH_REMATCH[3]:-0}")"
    echo "gpus: $gpus (most free memory now)"
  fi
  local pre cmd
  pre="$(env_prefix) && $(remote_guard) && echo \"code: \$(git log --oneline -1)\""
  [[ -n "$gpus" ]] && pre+="; export CUDA_VISIBLE_DEVICES=$(q "$gpus")"
  cmd="$(join_q "$@")"
  if [[ -z "$bg" ]]; then
    remote "$pre && $cmd"
    return
  fi
  [[ "$bg" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "--bg NAME: letters, digits, '_', '.', '-'"
  local log="$FLORA_REMOTE_DATA/logs/$bg.log"
  # Only the nohup command goes to the background, with every stream redirected, so ssh returns at once.
  # --norc --noprofile: on the server a detached bash otherwise reads a startup file that resets PATH.
  remote "mkdir -p $(q "$FLORA_REMOTE_DATA/logs") && $pre && { nohup setsid bash --norc --noprofile -c $(q "$cmd") > $(q "$log") 2>&1 < /dev/null & } && echo \"started $bg (pid \$!), log $log\""
}

cmd_log() {
  [[ $# -ge 1 ]] || die "usage: log NAME [LINES]"
  remote "tail -n $(q "${2:-40}") $(q "$FLORA_REMOTE_DATA/logs/$1.log")"
}

cmd_status() {
  remote "nvidia-smi --query-gpu=index,memory.used,memory.total,utilization.gpu --format=csv,noheader; echo; ticli worker list 2>&1 | head -20"
}

cmd_launch() {
  local flags=()
  while [[ $# -gt 0 && "$1" != "--" ]]; do flags+=("$1"); shift; done
  [[ "${1:-}" == "--" ]] && shift
  [[ $# -gt 0 ]] || die "usage: launch TICLI_FLAGS... -- CMD..."
  local inner
  inner="$(env_prefix) && $(remote_guard) && $(join_q "$@")"
  remote "$(env_prefix) && $(remote_guard) && ticli worker launch $(join_q "${flags[@]}") bash -lc $(q "$inner")"
}

cmd_shell() { exec ssh -t -p "${FLORA_REMOTE_PORT:-22}" "$FLORA_REMOTE"; }

command="${1:-}"
[[ -n "$command" ]] || { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 2; }
shift
case "$command" in
  sync|verify|push|pull|run|log|status|launch|shell) "cmd_$command" "$@" ;;
  *) die "unknown command '$command' (sync, verify, push, pull, run, log, status, launch, shell)" ;;
esac
