# Copy to remote.env (not tracked by git) and fill in; read by flora-remote.
FLORA_REMOTE=user@host
FLORA_REMOTE_PORT=22
FLORA_REMOTE_REPO=/path/to/Flora
FLORA_REMOTE_DATA=/path/to/kinseg
FLORA_REMOTE_PYTHON=/path/to/envs/flora-annotation/bin/python
FLORA_REMOTE_PROXY=http://127.0.0.1:7890
FLORA_REMOTE_LOCAL_MODELS=/path/to/Flora/workspace/flora_local.py
